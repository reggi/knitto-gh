{
  "name": "knitto-gh",
  "version": "0.0.0",
  "description": "GitHub fleet orchestration for Knitto-managed repositories",
  "repository": {
    "type": "git",
    "url": "https://github.com/reggi/knitto-gh.git"
  },
  "type": "module",
  "packageManager": "npm@12.0.2",
  "bin": {
    "knitto-gh": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx --import ./test/setup.ts \"test/**/*.test.ts\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "minimatch": "^10.0.3",
    "p-limit": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "license": "MIT",
  "private": false
}
